// A cargo pod: one walkable box, y = 0 (deck) to 3 (ceiling), inside 6 m
// wide (x = +-3) and 8 m long (z = -4 to 4), with an open hatch in each end
// (1.8 m wide, 2.4 m tall) onto the catwalks. A cargo rack along the +X side
// and a crate on the -X side for cover. It sits on two saddles on the
// train's spine (whose top is at y = -1.15). Placed several times by the
// pod train's design; it carries nothing that can't repeat (no markers,
// posts or devices).
Module(
    parts: [
        // Deck, roof, sides.
        Span(lo: (-3.3, -0.3, -4.3), hi: (3.3, 0.0, 4.3)),
        Span(lo: (-3.3, 3.0, -4.3), hi: (3.3, 3.3, 4.3)),
        Span(lo: (-3.3, 0.0, -4.3), hi: (-3.0, 3.0, 4.3)),
        Span(lo: (3.0, 0.0, -4.3), hi: (3.3, 3.0, 4.3)),
        // The end walls, each with its hatch.
        WallAcross(z: 4.15, x: (-3.0, 3.0), y: (0.0, 3.0), thickness: 0.3, doors: [(-0.9, 0.9, 2.4)]),
        WallAcross(z: -4.15, x: (-3.0, 3.0), y: (0.0, 3.0), thickness: 0.3, doors: [(-0.9, 0.9, 2.4)]),
        // The saddles, down to the spine.
        Box(center: (0.0, -0.725, 2.5), size: (1.6, 0.85, 1.0), material: Trim),
        Box(center: (0.0, -0.725, -2.5), size: (1.6, 0.85, 1.0), material: Trim),
        // The rack and the crate.
        Box(center: (2.3, 0.8, 0.0), size: (1.0, 1.6, 3.0), material: Trim),
        Box(center: (-2.2, 0.5, 2.5), size: (1.0, 1.0, 1.0), material: Trim),
        // Outside: a handling lug on the roof.
        Box(center: (0.0, 3.5, 0.0), size: (1.2, 0.4, 2.0), material: Trim),
    ],
    cabins: [(center: (0.0, 1.5, 0.0), size: (6.0, 3.0, 8.0))],
    lights: [(0.0, 2.7, 2.0), (0.0, 2.7, -2.0)],
)
