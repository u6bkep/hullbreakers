// The freighter: one deck, y = 0 (deck) to 3 (ceiling), inside 8 m wide
// (x = +-4) and 38 m long (z = -22, the bow, to +16, the stern).
//
// From the stern in: an airlock (open) onto the aft deck; then the breach,
// where the ship is broken in two (z = -6 to 2: no deck, sides or roof,
// only open space between the two halves' end walls), with a gangway that
// runs out across it only from its lever on the far (bow) side (or jump it
// on a jetpack); the bow hall; and the cargo bay, where the power cell is, behind a
// door that opens for 3 s at a turn of either of its keys (one in the hall,
// one in the bay) and stays open while anyone stands in its doorway.
// Whoever carries the cell has their hands full: they can't work a switch,
// so someone else turns the key, or they set the cell down and do it.
//
// Robots guard the aft deck and the bow hall.
Module(
    parts: [
        // The aft half: deck, roof, sides; the bow half likewise, and the
        // bow. Nothing between them (the breach, z = -6 to 2).
        Span(lo: (-4.3, -0.3, 1.9), hi: (4.3, 0.0, 16.3)),
        Span(lo: (-4.3, 3.0, 1.9), hi: (4.3, 3.3, 16.3)),
        Span(lo: (-4.3, 0.0, 1.9), hi: (-4.0, 3.0, 16.3)),
        Span(lo: (4.0, 0.0, 1.9), hi: (4.3, 3.0, 16.3)),
        Span(lo: (-4.3, -0.3, -22.3), hi: (4.3, 0.0, -5.9)),
        Span(lo: (-4.3, 3.0, -22.3), hi: (4.3, 3.3, -5.9)),
        Span(lo: (-4.3, 0.0, -22.3), hi: (-4.0, 3.0, -5.9)),
        Span(lo: (4.0, 0.0, -22.3), hi: (4.3, 3.0, -5.9)),
        Span(lo: (-4.0, 0.0, -22.3), hi: (4.0, 3.0, -22.0)),
        // Stern, with the airlock's outer door (open); the airlock's walls.
        WallAcross(z: 16.15, x: (-4.0, 4.0), y: (0.0, 3.0), thickness: 0.3, doors: [(-0.9, 0.9, 2.4)]),
        WallAlong(x: -1.6, z: (12.0, 16.0), y: (0.0, 3.0), thickness: 0.2),
        WallAlong(x: 1.6, z: (12.0, 16.0), y: (0.0, 3.0), thickness: 0.2),
        WallAcross(z: 12.0, x: (-4.0, 4.0), y: (0.0, 3.0), thickness: 0.2, doors: [(-0.8, 0.8, 2.3)]),
        // The breach's walls, aft and forward, with wide openings.
        WallAcross(z: 2.0, x: (-4.0, 4.0), y: (0.0, 3.0), thickness: 0.2, doors: [(-1.5, 1.5, 2.4)]),
        WallAcross(z: -6.0, x: (-4.0, 4.0), y: (0.0, 3.0), thickness: 0.2, doors: [(-1.5, 1.5, 2.4)]),
        // The bay's wall and door.
        WallAcross(z: -14.0, x: (-4.0, 4.0), y: (0.0, 3.0), thickness: 0.2, doors: [(-0.9, 0.9, 2.3)]),
        // Torn ends of the keel, sticking out into the breach.
        Box(center: (-3.0, -0.5, 0.6), size: (0.3, 0.3, 2.6), material: Trim),
        Box(center: (3.0, -0.5, -4.6), size: (0.3, 0.3, 2.6), material: Trim),
        // Cover on the aft deck and in the hall; racks in the bay.
        Box(center: (-2.4, 0.6, 7.0), size: (1.2, 1.2, 1.2), material: Trim),
        Box(center: (2.6, 0.5, 9.5), size: (1.0, 1.0, 1.6), material: Trim),
        Box(center: (2.4, 0.6, 4.5), size: (1.4, 1.2, 1.0), material: Trim),
        Box(center: (2.5, 0.6, -10.0), size: (1.2, 1.2, 1.2), material: Trim),
        Box(center: (-2.8, 0.5, -12.5), size: (1.4, 1.0, 1.0), material: Trim),
        Box(center: (-3.2, 0.8, -18.5), size: (1.2, 1.6, 3.0), material: Trim),
        Box(center: (3.2, 0.8, -18.5), size: (1.2, 1.6, 3.0), material: Trim),
        // Outside: engines either side of the airlock, a spine, a mast.
        Box(center: (-3.0, 1.5, 17.8), size: (2.0, 2.0, 3.0)),
        Box(center: (3.0, 1.5, 17.8), size: (2.0, 2.0, 3.0)),
        Box(center: (0.0, 3.6, -13.0), size: (3.0, 0.6, 14.0), material: Trim),
        Box(center: (2.0, 4.6, 8.0), size: (0.3, 2.0, 0.3), material: Trim),
    ],
    cabins: [
        (center: (0.0, 1.5, 9.0), size: (8.0, 3.0, 14.0)),
        (center: (0.0, 1.5, -14.0), size: (8.0, 3.0, 16.0)),
    ],
    lights: [(0.0, 2.7, 14.0), (0.0, 2.7, 7.0), (0.0, 2.7, -10.0), (0.0, 2.7, -18.0)],
    posts: [
        (robot: Gunner, at: (-2.5, 0.0, 4.0), facing: 180.0),
        (robot: Gunner, at: (1.0, 0.0, 9.0), facing: 180.0),
        (robot: Gunner, at: (-1.5, 0.0, -9.5), facing: 180.0),
        (robot: Gunner, at: (2.0, 0.0, -12.5), facing: 180.0),
    ],
    markers: {
        "entry": (0.0, 0.0, 14.0),
        "objective": (0.0, 0.0, -18.0),
        "loot_hall": (0.0, 0.0, -8.0),
    },
    devices: [
        (id: "gangway_lever", label: "Gangway", kind: Lever, at: (2.8, 1.3, -6.12), face: (0.0, 0.0, -1.0)),
        (id: "gangway", label: "Gangway", kind: Bridge(size: (2.0, 0.2, 8.0)), at: (0.0, -0.1, -2.0), power: On("gangway_lever")),
        (id: "bay_key_hall", label: "Bay door key", kind: Key(hold: 3.0), at: (-3.92, 1.3, -10.0), face: (1.0, 0.0, 0.0)),
        (id: "bay_key_bay", label: "Bay door key", kind: Key(hold: 3.0), at: (3.92, 1.3, -16.0), face: (-1.0, 0.0, 0.0)),
        (id: "bay_doorway", kind: Sensor(size: (1.8, 2.2, 1.2)), at: (0.0, 1.1, -14.0)),
        (id: "bay_door", label: "Bay door", kind: Door(size: (1.8, 2.3, 0.15)), at: (0.0, 1.15, -14.0), face: (0.0, 0.0, 1.0),
         power: Any([On("bay_key_hall"), On("bay_key_bay"), On("bay_doorway")])),
        (id: "bay_lamp", label: "Bay door", kind: Lamp, at: (1.3, 2.5, -13.88), face: (0.0, 0.0, 1.0), power: On("bay_door")),
    ],
)
