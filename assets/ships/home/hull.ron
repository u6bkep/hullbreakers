// The crew's ship: a single deck, y = 0 (deck) to 3 (ceiling), interior
// half-width 3.7, from z = -15 (the bow) to +15 (the stern, an open cargo
// door). A bulkhead amidships splits the bridge from the hold.
Module(
    parts: [
        // Floor, ceiling, side walls.
        Box(center: (0.0, -0.15, 0.0), size: (8.0, 0.3, 30.0)),
        Box(center: (0.0, 3.15, 0.0), size: (8.0, 0.3, 30.0)),
        Box(center: (-3.85, 1.5, 0.0), size: (0.3, 3.0, 30.0)),
        Box(center: (3.85, 1.5, 0.0), size: (0.3, 3.0, 30.0)),
        // Bow wall with a window slot between y = 1.2 and y = 2.0.
        Box(center: (0.0, 0.6, -14.85), size: (7.4, 1.2, 0.3)),
        Box(center: (0.0, 2.5, -14.85), size: (7.4, 1.0, 0.3)),
        // Stern: open cargo door, 3 m wide by 2.4 m high.
        Box(center: (-2.6, 1.5, 14.85), size: (2.2, 3.0, 0.3)),
        Box(center: (2.6, 1.5, 14.85), size: (2.2, 3.0, 0.3)),
        Box(center: (0.0, 2.7, 14.85), size: (3.0, 0.6, 0.3)),
        // Mid bulkhead with a doorway 1.2 m wide by 2.2 m high.
        Box(center: (-2.15, 1.5, 0.0), size: (3.1, 3.0, 0.3)),
        Box(center: (2.15, 1.5, 0.0), size: (3.1, 3.0, 0.3)),
        Box(center: (0.0, 2.6, 0.0), size: (1.2, 0.8, 0.3)),
        // Cargo crates in the aft hold.
        Box(center: (-2.6, 0.6, 9.0), size: (1.2, 1.2, 1.2), material: Trim),
        Box(center: (-2.6, 0.5, 10.4), size: (1.0, 1.0, 1.4), material: Trim),
        Box(center: (2.4, 0.9, 6.0), size: (1.6, 1.8, 1.6), material: Trim),
        // Bridge console.
        Box(center: (0.0, 0.5, -13.0), size: (4.0, 1.0, 0.8), material: Trim),
        // Dorsal spine: a raised walkway along the top.
        Box(center: (0.0, 3.7, 2.0), size: (2.0, 0.8, 18.0), material: Trim),
        // Antenna mast.
        Box(center: (0.0, 5.3, -9.0), size: (0.3, 4.0, 0.3), material: Trim),
        // Engine nacelles on pylons.
        Box(center: (-5.4, 1.5, 11.0), size: (1.6, 1.6, 8.0)),
        Box(center: (5.4, 1.5, 11.0), size: (1.6, 1.6, 8.0)),
        Box(center: (-4.3, 1.5, 11.0), size: (0.6, 0.4, 3.0), material: Trim),
        Box(center: (4.3, 1.5, 11.0), size: (0.6, 0.4, 3.0), material: Trim),
        // The mission wall: a panel on the port side of the bridge.
        Box(center: (-3.65, 1.5, -7.0), size: (0.1, 1.4, 4.4), material: Trim),
        // The weapons locker's door, on the starboard wall of the hold.
        Box(center: (3.65, 1.4, 9.0), size: (0.1, 2.0, 1.4), material: Trim),
        // The workbench, aft of it: a bench along the wall.
        Box(center: (3.35, 0.9, 11.6), size: (0.7, 0.1, 1.6), material: Trim),
        Box(center: (3.35, 0.45, 11.6), size: (0.5, 0.9, 1.4), material: Trim),
    ],
    controls: [
        // Buttons on the mission wall, sticking out of the panel: one per
        // scenario in two rows (the fights and the field above, the
        // others below), and lower and apart from the rest, the lurch.
        (action: Scenario(Field), center: (-3.54, 1.92, -8.4), half_size: (0.06, 0.22, 0.4)),
        (action: Scenario(Boarding), center: (-3.54, 1.92, -7.3), half_size: (0.06, 0.22, 0.4)),
        (action: Scenario(Gallery), center: (-3.54, 1.92, -6.2), half_size: (0.06, 0.22, 0.4)),
        (action: Scenario(Scene), center: (-3.54, 1.92, -5.15), half_size: (0.06, 0.22, 0.35)),
        (action: Scenario(GrappleRun), center: (-3.54, 1.4, -8.4), half_size: (0.06, 0.22, 0.4)),
        (action: Scenario(DeadShip), center: (-3.54, 1.4, -7.3), half_size: (0.06, 0.22, 0.4)),
        (action: Scenario(Recovery), center: (-3.54, 1.4, -6.2), half_size: (0.06, 0.22, 0.4)),
        (action: Scenario(Escort), center: (-3.54, 1.4, -5.15), half_size: (0.06, 0.22, 0.35)),
        (action: Lurch, center: (-3.54, 0.95, -5.4), half_size: (0.06, 0.13, 0.25)),
        // The weapons locker.
        (action: Armory, center: (3.54, 1.5, 9.0), half_size: (0.06, 0.45, 0.5)),
        // The workbench's panel, on the wall over the bench.
        (action: Workbench, center: (3.54, 1.45, 11.6), half_size: (0.06, 0.3, 0.6)),
    ],
    cabins: [(center: (0.0, 1.5, 0.0), size: (7.8, 3.3, 29.8))],
    lights: [(0.0, 2.7, -10.0), (0.0, 2.7, -4.0), (0.0, 2.7, 5.0), (0.0, 2.7, 11.0)],
    // The ship's power: the main bus junction and two breakers on the
    // hold's port wall feed the turrets and the shield; the board on the
    // bridge's starboard wall shows what's live. Hits in a fight can trip a
    // breaker or knock the bus off its way (`fault`), and someone has to go
    // aft and put it right. Main bus: way 0 feeds everything; way 1 only
    // the shield; way 2 only the turrets.
    devices: [
        (id: "main", label: "Main bus", kind: Junction(ways: 3), at: (-3.62, 1.4, 3.0), face: (1.0, 0.0, 0.0), fault: true),
        (id: "turret_breaker", label: "Turret breaker", kind: Lever, at: (-3.62, 1.3, 5.5), face: (1.0, 0.0, 0.0), start: 1, fault: true),
        (id: "shield_breaker", label: "Shield breaker", kind: Lever, at: (-3.62, 1.3, 13.0), face: (1.0, 0.0, 0.0), start: 1, fault: true),
        // What they feed: turret `turret_N` fires only while its lamp is
        // lit, and the shield holds only while `shield` is.
        (id: "turret_0", label: "Dorsal turret", kind: Lamp, at: (-3.66, 2.7, -4.0), face: (1.0, 0.0, 0.0),
         power: All([Any([Port("main", 0), Port("main", 2)]), On("turret_breaker")])),
        (id: "turret_1", label: "Ventral turret", kind: Lamp, at: (-3.66, 2.7, -6.0), face: (1.0, 0.0, 0.0),
         power: All([Any([Port("main", 0), Port("main", 2)]), On("turret_breaker")])),
        (id: "shield", label: "Shield emitter", kind: Lamp, at: (1.5, 2.6, -14.66), face: (0.0, 0.0, 1.0),
         power: All([Any([Port("main", 0), Port("main", 1)]), On("shield_breaker")])),
        (id: "board", label: "Power board", kind: Board(size: (1.4, 1.3), rows: [
            ("ALL SYSTEMS", Port("main", 0)),
            ("TURRET BRKR", On("turret_breaker")),
            ("SHIELD BRKR", On("shield_breaker")),
            ("TURRET DORSAL", On("turret_0")),
            ("TURRET VENTRAL", On("turret_1")),
            ("SHIELD", On("shield")),
        ]), at: (3.64, 1.6, -9.0), face: (-1.0, 0.0, 0.0)),
        // The runs aft to forward, along the port wall's ceiling corner (the
        // shield's above the turrets'), 5 cm off it; the shield's then along
        // the bow wall to its emitter, above the window.
        (id: "c_turrets", kind: Conduit(path: [(-3.65, 1.72, 3.0), (-3.65, 2.89, 3.0), (-3.65, 2.89, -6.0)]),
         power: Any([Port("main", 0), Port("main", 2)])),
        (id: "c_shield", kind: Conduit(path: [(-3.65, 1.62, 13.0), (-3.65, 2.95, 13.0), (-3.65, 2.95, -14.65), (1.5, 2.95, -14.65), (1.5, 2.75, -14.65)]),
         power: On("shield")),
    ],
)
