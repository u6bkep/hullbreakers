// The crew's ship: a single deck, y = 0 (deck) to 3 (ceiling), interior
// half-width 3.7, from z = -15 (the bow) to +15 (the stern, an open cargo
// door). A bulkhead amidships splits the bridge from the hold.
Module(
    parts: [
        // Floor, ceiling, side walls.
        Box(center: (0.0, -0.15, 0.0), size: (8.0, 0.3, 30.0)),
        Box(center: (0.0, 3.15, 0.0), size: (8.0, 0.3, 30.0)),
        Box(center: (-3.85, 1.5, 0.0), size: (0.3, 3.0, 30.0)),
        Box(center: (3.85, 1.5, 0.0), size: (0.3, 3.0, 30.0)),
        // Bow wall with a window slot between y = 1.2 and y = 2.0.
        Box(center: (0.0, 0.6, -14.85), size: (7.4, 1.2, 0.3)),
        Box(center: (0.0, 2.5, -14.85), size: (7.4, 1.0, 0.3)),
        // Stern: open cargo door, 3 m wide by 2.4 m high.
        Box(center: (-2.6, 1.5, 14.85), size: (2.2, 3.0, 0.3)),
        Box(center: (2.6, 1.5, 14.85), size: (2.2, 3.0, 0.3)),
        Box(center: (0.0, 2.7, 14.85), size: (3.0, 0.6, 0.3)),
        // Mid bulkhead with a doorway 1.2 m wide by 2.2 m high.
        Box(center: (-2.15, 1.5, 0.0), size: (3.1, 3.0, 0.3)),
        Box(center: (2.15, 1.5, 0.0), size: (3.1, 3.0, 0.3)),
        Box(center: (0.0, 2.6, 0.0), size: (1.2, 0.8, 0.3)),
        // Cargo crates in the aft hold.
        Box(center: (-2.6, 0.6, 9.0), size: (1.2, 1.2, 1.2), material: Trim),
        Box(center: (-2.6, 0.5, 10.4), size: (1.0, 1.0, 1.4), material: Trim),
        Box(center: (2.4, 0.9, 6.0), size: (1.6, 1.8, 1.6), material: Trim),
        // Bridge console.
        Box(center: (0.0, 0.5, -13.0), size: (4.0, 1.0, 0.8), material: Trim),
        // Dorsal spine: a raised walkway along the top.
        Box(center: (0.0, 3.7, 2.0), size: (2.0, 0.8, 18.0), material: Trim),
        // Antenna mast.
        Box(center: (0.0, 5.3, -9.0), size: (0.3, 4.0, 0.3), material: Trim),
        // Engine nacelles on pylons.
        Box(center: (-5.4, 1.5, 11.0), size: (1.6, 1.6, 8.0)),
        Box(center: (5.4, 1.5, 11.0), size: (1.6, 1.6, 8.0)),
        Box(center: (-4.3, 1.5, 11.0), size: (0.6, 0.4, 3.0), material: Trim),
        Box(center: (4.3, 1.5, 11.0), size: (0.6, 0.4, 3.0), material: Trim),
        // The mission wall: a panel on the port side of the bridge.
        Box(center: (-3.65, 1.5, -7.0), size: (0.1, 1.4, 4.4), material: Trim),
        // The weapons locker's door, on the starboard wall of the hold.
        Box(center: (3.65, 1.4, 9.0), size: (0.1, 2.0, 1.4), material: Trim),
    ],
    controls: [
        // Buttons on the mission wall, sticking out of the panel: one per
        // scenario in two rows (the fights and the field above, the
        // others below), and lower and apart from the rest, the lurch.
        (action: Scenario(Field), center: (-3.54, 1.92, -8.4), half_size: (0.06, 0.22, 0.4)),
        (action: Scenario(Boarding), center: (-3.54, 1.92, -7.3), half_size: (0.06, 0.22, 0.4)),
        (action: Scenario(Gallery), center: (-3.54, 1.92, -6.2), half_size: (0.06, 0.22, 0.4)),
        (action: Scenario(GrappleRun), center: (-3.54, 1.4, -8.4), half_size: (0.06, 0.22, 0.4)),
        (action: Scenario(DeadShip), center: (-3.54, 1.4, -7.3), half_size: (0.06, 0.22, 0.4)),
        (action: Lurch, center: (-3.54, 1.05, -5.4), half_size: (0.06, 0.18, 0.25)),
        // The weapons locker.
        (action: Armory, center: (3.54, 1.5, 9.0), half_size: (0.06, 0.45, 0.5)),
    ],
    cabins: [(center: (0.0, 1.5, 0.0), size: (7.8, 3.3, 29.8))],
    lights: [(0.0, 2.7, -10.0), (0.0, 2.7, -4.0), (0.0, 2.7, 5.0), (0.0, 2.7, 11.0)],
)
