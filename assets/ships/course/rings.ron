// The race course: twelve rings strung round a three-kilometre loop through
// a rock field, from just off our ship's stern and back. Each ring is 24 m
// across, a hologram (nothing to hit), and counts only flown the way it
// faces. Between each pair of rings the course turns at an apex, and the
// scenario sets a big anchor rock on the inside of every turn: the line is
// to hook it and swing round (see `sim::scenarios::grapple_run`). The posts
// mark the start and the finish; they're the only structure.
//
// The course's coordinates: its origin is the start ring, 17 m off our
// stern, +Z away from the ship. Its geometry was laid out with a script
// (legs of 160-360 m; turns of 44-151 degrees; climbs and dives over
// 400 m): each ring lies on the leg into its apex, midway along the
// straight between the swings at either end (where a rope round each
// anchor would leave and meet the leg). Edit rings and apexes together.
Module(
    parts: [
        // The start post, beside the start ring, and the finish post.
        Box(center: (16.0, 0.0, 0.0), size: (1.2, 10.0, 1.2), material: Trim),
        Box(center: (-59.6, -15.4, 76.0), size: (1.2, 10.0, 1.2), material: Trim),
    ],
    devices: [
        (id: "r1", label: "Start", kind: Ring(radius: 12.0), at: (0.0, 0.0, 0.0), face: (0.000, 0.040, 0.999)),
        (id: "r2", label: "Ring 2", kind: Ring(radius: 12.0), at: (130.9, 24.3, 265.3), face: (0.960, 0.111, 0.258)),
        (id: "r3", label: "Ring 3", kind: Ring(radius: 12.0), at: (293.6, 139.9, 266.4), face: (0.302, 0.905, -0.302)),
        (id: "r4", label: "Ring 4", kind: Ring(radius: 12.0), at: (324.8, 207.9, 49.3), face: (-0.028, -0.223, -0.974)),
        (id: "r5", label: "Ring 5", kind: Ring(radius: 12.0), at: (184.6, 148.4, -166.9), face: (-0.935, -0.144, -0.324)),
        (id: "r6", label: "Ring 6", kind: Ring(radius: 12.0), at: (-26.9, 109.9, -166.5), face: (-0.877, -0.195, 0.439)),
        (id: "r7", label: "Ring 7", kind: Ring(radius: 12.0), at: (-200.2, 69.1, -175.1), face: (-0.807, -0.202, -0.555)),
        (id: "r8", label: "Ring 8", kind: Ring(radius: 12.0), at: (-353.5, 33.7, -195.2), face: (-0.888, -0.187, 0.421)),
        (id: "r9", label: "Ring 9", kind: Ring(radius: 12.0), at: (-344.3, -62.6, -62.2), face: (0.765, -0.437, 0.473)),
        (id: "r10", label: "Ring 10", kind: Ring(radius: 12.0), at: (-240.3, -120.6, 71.1), face: (0.234, -0.117, 0.965)),
        (id: "r11", label: "Ring 11", kind: Ring(radius: 12.0), at: (-133.2, -65.0, 117.2), face: (0.208, 0.381, -0.901)),
        (id: "r12", label: "Finish", kind: Ring(radius: 12.0), at: (-59.6, -15.4, 60.0), face: (0.922, 0.388, 0.000)),
    ],
    // Where the course turns, between each ring and the next (each with an
    // anchor rock inside the turn).
    markers: {
        "apex1": (0.0, 9.2, 230.0),
        "apex2": (260.0, 39.2, 300.0),
        "apex3": (330.0, 249.2, 230.0),
        "apex4": (320.0, 169.2, -120.0),
        "apex5": (60.0, 129.2, -210.0),
        "apex6": (-120.0, 89.2, -120.0),
        "apex7": (-280.0, 49.2, -230.0),
        "apex8": (-470.0, 9.2, -140.0),
        "apex9": (-260.0, -110.8, -10.0),
        "apex10": (-180.0, -150.8, 320.0),
        "apex11": (-120.0, -40.8, 60.0),
    },
)
