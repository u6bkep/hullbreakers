// The course's gates, in the order they're flown: each a 7 m square
// opening in a frame (structure, so it can be grappled), counted only when
// flown the way it faces (in from behind). The course's origin is the first
// gate, 17 m off our stern.
//
// It's a switchback: lanes 8 m apart, 20 m from gate to gate along each,
// with a hairpin at every lane's end round a pylon (a post, or a bar where
// the course climbs or drops a level). A rope on the pylon swings you round
// it at full speed; the jetpack (20 m/s at most, 20 m/s² to turn with) has
// to brake to about half that to make a 4 m turn, then build it up again.
// Outbound at y = 0, from x = 0 to 24; up a level; back at y = 8 to
// x = -8; down to the finish. Three posts serve both levels.
Module(
    parts: [
        // The pylons: posts for the turns in a level, bars for the climb
        // and the drop.
        Box(center: (4.0, 4.0, 30.0), size: (1.0, 16.0, 1.0), material: Trim),
        Box(center: (12.0, 4.0, -10.0), size: (1.0, 16.0, 1.0), material: Trim),
        Box(center: (20.0, 4.0, 30.0), size: (1.0, 16.0, 1.0), material: Trim),
        Box(center: (24.0, 4.0, -10.0), size: (8.0, 1.0, 1.0), material: Trim),
        Box(center: (-4.0, 8.0, -10.0), size: (1.0, 8.0, 1.0), material: Trim),
        Box(center: (-8.0, 4.0, 30.0), size: (8.0, 1.0, 1.0), material: Trim),
    ],
    devices: [
        (id: "g1", label: "Gate 1", kind: Gate(size: (7.0, 7.0)), at: (0.0, 0.0, 0.0), face: (0.0, 0.0, 1.0)),
        (id: "g2", label: "Gate 2", kind: Gate(size: (7.0, 7.0)), at: (8.0, 0.0, 20.0), face: (0.0, 0.0, -1.0)),
        (id: "g3", label: "Gate 3", kind: Gate(size: (7.0, 7.0)), at: (16.0, 0.0, 0.0), face: (0.0, 0.0, 1.0)),
        (id: "g4", label: "Gate 4", kind: Gate(size: (7.0, 7.0)), at: (24.0, 0.0, 20.0), face: (0.0, 0.0, -1.0)),
        (id: "g5", label: "Gate 5", kind: Gate(size: (7.0, 7.0)), at: (24.0, 8.0, 0.0), face: (0.0, 0.0, 1.0)),
        (id: "g6", label: "Gate 6", kind: Gate(size: (7.0, 7.0)), at: (16.0, 8.0, 20.0), face: (0.0, 0.0, -1.0)),
        (id: "g7", label: "Gate 7", kind: Gate(size: (7.0, 7.0)), at: (8.0, 8.0, 0.0), face: (0.0, 0.0, 1.0)),
        (id: "g8", label: "Gate 8", kind: Gate(size: (7.0, 7.0)), at: (0.0, 8.0, 20.0), face: (0.0, 0.0, -1.0)),
        (id: "g9", label: "Gate 9", kind: Gate(size: (7.0, 7.0)), at: (-8.0, 8.0, 0.0), face: (0.0, 0.0, 1.0)),
        (id: "g10", label: "Finish", kind: Gate(size: (7.0, 7.0)), at: (-8.0, 0.0, 20.0), face: (0.0, 0.0, -1.0)),
    ],
)
