// The relay: a boxy core on four legs, a dish on its port wing and a mast
// over its deep end, a docking collar at the stern. Inside, 16 m wide
// (x = +-8) and 24 m long (z = -14, the bow, to +10, the stern), plus the
// collar (z = 10 to 14). Lower deck y = 0 to 3; the forward block has an
// upper deck, y = 3.3 to 6.3; the hall is open to the roof (6.3).
//
// From the collar in: the equipment hall (16 m long, double height, crates
// for cover) with a ramp up its port wall to a landing and the upper
// deck's door. The port wing (one storey) is the workshop, with doors into
// the hall fore and aft and into the storeroom forward: a loop. Forward of
// the hall, below: the storeroom (port) and the power room (starboard).
// Above: the transmitter room, the deepest point, with the transmitter
// against the bow under a window band.
//
// The chain: the main breaker (a pull, in the power room) powers the power
// board and the feed selector (a three-way junction beside it). The
// selector's ways: 0 DISH DRIVE (lamps on the dish), 1 QUARTERS (the
// workshop's lights), 2 TX BUS (the transmitter room's lights and the
// transmitter). The coolant valve (a pull, in the workshop) feeds the
// transmitter too. With TX BUS and coolant both live, the transmitter's
// lever brings it on the air, and the beacon at the top of the mast lights.
// The board in the power room shows every link; a repeater upstairs shows
// what the transmitter is waiting for.
Module(
    parts: [
        // Floor; the roofs (the hall and the forward block high, the port
        // wing low); outer walls.
        Span(lo: (-8.3, -0.3, -14.3), hi: (8.3, 0.0, 10.3)),
        Span(lo: (-3.65, 6.3, -14.3), hi: (8.3, 6.6, 10.3)),
        Span(lo: (-8.3, 6.3, -14.3), hi: (-3.65, 6.6, -6.0)),
        Span(lo: (-8.3, 3.0, -6.0), hi: (-3.65, 3.3, 10.3)),
        Span(lo: (8.0, 0.0, -14.3), hi: (8.3, 6.3, 10.3)),
        Span(lo: (-8.3, 0.0, -14.3), hi: (-8.0, 3.0, 10.3)),
        Span(lo: (-8.3, 3.0, -14.3), hi: (-8.0, 6.3, -6.0)),
        // Bow, with a window band across the transmitter room.
        Span(lo: (-8.3, 0.0, -14.3), hi: (8.3, 4.6, -14.0)),
        Span(lo: (-8.3, 5.4, -14.3), hi: (8.3, 6.3, -14.0)),
        // Stern: the hall's (with the collar's inner door) and the port
        // wing's.
        WallAcross(z: 10.15, x: (-3.65, 8.3), y: (0.0, 6.3), thickness: 0.3, doors: [(-0.8, 0.8, 2.3)]),
        WallAcross(z: 10.15, x: (-8.3, -3.65), y: (0.0, 3.0), thickness: 0.3),
        // The docking collar: floor, roof, sides, the outer door (open).
        Span(lo: (-2.0, -0.3, 10.3), hi: (2.0, 0.0, 14.3)),
        Span(lo: (-2.0, 3.0, 10.3), hi: (2.0, 3.3, 14.3)),
        WallAlong(x: -1.9, z: (10.3, 14.0), y: (0.0, 3.0), thickness: 0.2),
        WallAlong(x: 1.9, z: (10.3, 14.0), y: (0.0, 3.0), thickness: 0.2),
        WallAcross(z: 14.15, x: (-2.0, 2.0), y: (0.0, 3.0), thickness: 0.3, doors: [(-0.9, 0.9, 2.4)]),
        // The hall's port wall (to the workshop: doors fore, under the
        // landing, and aft, past the ramp's foot).
        WallAlong(x: -3.5, z: (-6.0, 10.0), y: (0.0, 6.3), thickness: 0.3, doors: [(-5.5, -4.0, 2.3), (7.0, 8.6, 2.3)]),
        // The forward bulkhead: below, doors to the workshop->storeroom,
        // the hall->storeroom and the hall->power room; above, the
        // transmitter room's door off the landing.
        WallAcross(z: -6.0, x: (-8.0, 8.0), y: (0.0, 3.0), thickness: 0.3, doors: [(-6.6, -5.0, 2.3), (-0.8, 0.6, 2.3), (4.0, 5.6, 2.3)]),
        WallAcross(z: -6.0, x: (-8.3, 8.0), y: (3.3, 6.3), thickness: 0.3, doors: [(-3.2, -1.1, 5.6)]),
        // The upper deck, and the wall between storeroom and power room.
        Span(lo: (-8.0, 3.0, -14.0), hi: (8.0, 3.3, -6.0)),
        WallAlong(x: 1.0, z: (-14.0, -6.0), y: (0.0, 3.0), thickness: 0.2),
        // The ramp up the hall's port wall, z = 6 (floor) to z = -3
        // (20 degrees), and its landing to the upper door.
        Ramp(foot: (-2.15, 0.0, 6.0), top: (-2.15, 3.3, -3.0), width: 2.4, thickness: 0.3),
        Span(lo: (-3.35, 3.0, -6.0), hi: (-0.95, 3.3, -3.0)),
        // The hall: crates for cover, consoles along the starboard wall.
        Box(center: (5.5, 0.6, 7.5), size: (1.2, 1.2, 1.2), material: Trim),
        Box(center: (2.0, 0.5, 3.0), size: (1.4, 1.0, 1.0), material: Trim),
        Box(center: (5.0, 0.6, -0.5), size: (1.2, 1.2, 1.6), material: Trim),
        Box(center: (0.8, 0.75, -2.0), size: (1.5, 1.5, 1.5), material: Trim),
        Box(center: (7.4, 0.5, 3.5), size: (1.0, 1.0, 4.0), material: Trim),
        Box(center: (7.4, 0.5, -3.5), size: (1.0, 1.0, 3.0), material: Trim),
        // The workshop: a bench, a coolant tank, lockers.
        Box(center: (-7.4, 0.5, 6.0), size: (1.0, 1.0, 3.0), material: Trim),
        Box(center: (-7.0, 1.0, -2.5), size: (1.8, 2.0, 1.6), material: Trim),
        Box(center: (-4.15, 1.0, 1.5), size: (0.6, 2.0, 2.4), material: Trim),
        // The storeroom's crates; the power room's transformer.
        Box(center: (-6.5, 0.6, -12.5), size: (1.6, 1.2, 1.6), material: Trim),
        Box(center: (-6.8, 0.5, -9.0), size: (1.0, 1.0, 1.4), material: Trim),
        Box(center: (-1.5, 0.6, -12.8), size: (1.2, 1.2, 1.2), material: Trim),
        Box(center: (6.8, 1.0, -7.4), size: (2.0, 2.0, 1.6), material: Trim),
        // The transmitter room: the transmitter against the bow, a console,
        // crates.
        Box(center: (2.0, 4.3, -13.2), size: (5.0, 2.0, 1.4), material: Trim),
        Box(center: (-5.5, 3.8, -13.4), size: (3.0, 1.0, 1.0), material: Trim),
        Box(center: (-4.5, 3.9, -9.0), size: (1.2, 1.2, 1.2), material: Trim),
        Box(center: (5.5, 3.9, -8.5), size: (1.4, 1.2, 1.2), material: Trim),
        // Outside. The collar's docking ring.
        Box(center: (0.0, 3.55, 14.45), size: (5.0, 0.5, 0.3), material: Trim),
        Box(center: (0.0, -0.55, 14.45), size: (5.0, 0.5, 0.3), material: Trim),
        Box(center: (-2.25, 1.5, 14.45), size: (0.5, 3.6, 0.3), material: Trim),
        Box(center: (2.25, 1.5, 14.45), size: (0.5, 3.6, 0.3), material: Trim),
        // Legs and their feet; a belly pod between them.
        Box(center: (-6.5, -3.3, 7.5), size: (0.6, 6.0, 0.6)),
        Box(center: (6.5, -3.3, 7.5), size: (0.6, 6.0, 0.6)),
        Box(center: (-6.5, -3.3, -11.5), size: (0.6, 6.0, 0.6)),
        Box(center: (6.5, -3.3, -11.5), size: (0.6, 6.0, 0.6)),
        Box(center: (-6.5, -6.45, 7.5), size: (1.8, 0.3, 1.8), material: Trim),
        Box(center: (6.5, -6.45, 7.5), size: (1.8, 0.3, 1.8), material: Trim),
        Box(center: (-6.5, -6.45, -11.5), size: (1.8, 0.3, 1.8), material: Trim),
        Box(center: (6.5, -6.45, -11.5), size: (1.8, 0.3, 1.8), material: Trim),
        Box(center: (0.0, -1.0, -3.0), size: (8.0, 1.4, 10.0)),
        // The dish, on its pedestal on the port wing: a hub, twelve petals
        // tipped up 35 degrees round it, and a feed on a strut.
        Box(center: (-5.8, 4.8, 2.5), size: (1.0, 3.0, 1.0)),
        Box(center: (-5.8, 6.6, 2.5), size: (2.0, 0.6, 2.0), material: Trim),
        Ramp(foot: (-5.03, 6.9, 2.71), top: (-1.16, 9.7, 3.74), width: 2.3, thickness: 0.15),
        Ramp(foot: (-5.23, 6.9, 3.07), top: (-2.41, 9.7, 5.89), width: 2.3, thickness: 0.15),
        Ramp(foot: (-5.59, 6.9, 3.27), top: (-4.56, 9.7, 7.14), width: 2.3, thickness: 0.15),
        Ramp(foot: (-6.01, 6.9, 3.27), top: (-7.04, 9.7, 7.14), width: 2.3, thickness: 0.15),
        Ramp(foot: (-6.37, 6.9, 3.07), top: (-9.19, 9.7, 5.89), width: 2.3, thickness: 0.15),
        Ramp(foot: (-6.57, 6.9, 2.71), top: (-10.44, 9.7, 3.74), width: 2.3, thickness: 0.15),
        Ramp(foot: (-6.57, 6.9, 2.29), top: (-10.44, 9.7, 1.26), width: 2.3, thickness: 0.15),
        Ramp(foot: (-6.37, 6.9, 1.93), top: (-9.19, 9.7, -0.89), width: 2.3, thickness: 0.15),
        Ramp(foot: (-6.01, 6.9, 1.73), top: (-7.04, 9.7, -2.14), width: 2.3, thickness: 0.15),
        Ramp(foot: (-5.59, 6.9, 1.73), top: (-4.56, 9.7, -2.14), width: 2.3, thickness: 0.15),
        Ramp(foot: (-5.23, 6.9, 1.93), top: (-2.41, 9.7, -0.89), width: 2.3, thickness: 0.15),
        Ramp(foot: (-5.03, 6.9, 2.29), top: (-1.16, 9.7, 1.26), width: 2.3, thickness: 0.15),
        Box(center: (-5.8, 8.7, 2.5), size: (0.2, 3.6, 0.2), material: Trim),
        Box(center: (-5.8, 10.7, 2.5), size: (0.7, 0.7, 0.7), material: Trim),
        // The mast over the transmitter room: a base, the mast, its yards,
        // the beacon's housing at the top.
        Box(center: (5.0, 7.1, -10.0), size: (2.0, 1.0, 2.0)),
        Box(center: (5.0, 15.6, -10.0), size: (0.4, 16.0, 0.4), material: Trim),
        Box(center: (5.0, 12.0, -10.0), size: (4.0, 0.2, 0.2), material: Trim),
        Box(center: (5.0, 16.0, -10.0), size: (0.2, 0.2, 3.2), material: Trim),
        Box(center: (5.0, 20.0, -10.0), size: (2.4, 0.2, 0.2), material: Trim),
        Box(center: (5.0, 23.9, -10.0), size: (0.6, 0.6, 0.6), material: Trim),
        // Whips on the hall's roof; a radiator wing to starboard.
        Box(center: (0.5, 8.1, 8.0), size: (0.15, 3.0, 0.15), material: Trim),
        Box(center: (2.0, 7.6, 8.5), size: (0.15, 2.0, 0.15), material: Trim),
        Box(center: (8.75, 3.0, 0.0), size: (0.9, 0.3, 0.3)),
        Box(center: (10.7, 3.0, 0.0), size: (3.0, 0.15, 10.0), material: Trim),
    ],
    cabins: [
        (center: (0.0, 1.5, 12.2), size: (3.6, 3.0, 3.9)),
        (center: (2.18, 3.15, 2.0), size: (11.65, 6.3, 16.0)),
        (center: (-5.8, 1.5, 2.0), size: (4.35, 3.0, 16.0)),
        (center: (0.0, 1.5, -10.0), size: (16.0, 3.0, 8.0)),
        (center: (0.0, 4.8, -10.0), size: (16.0, 3.0, 8.0)),
    ],
    // The station's own lights (on its batteries; the transmitter room's
    // full lights come with the TX bus).
    lights: [
        (0.0, 2.7, 12.2),
        (2.5, 5.9, 5.0), (2.5, 5.9, -2.0),
        (-5.8, 2.7, 6.0),
        (-3.5, 2.7, -10.0), (4.5, 2.7, -10.0),
        (-2.0, 6.0, -7.0),
    ],
    // Gunners along the way to the transmitter, facing the collar; turrets
    // on the roof and under the floor covering the approach; a crawler on
    // the port wing.
    posts: [
        (robot: Gunner, at: (4.5, 0.0, 5.5), facing: 180.0),    // the hall, aft
        (robot: Gunner, at: (2.0, 0.0, -3.8), facing: 180.0),   // the hall, forward
        (robot: Gunner, at: (-2.15, 3.3, -4.5), facing: 180.0), // the landing, over the hall
        (robot: Gunner, at: (4.5, 0.0, -10.5), facing: 180.0),  // the power room
        (robot: Gunner, at: (-2.5, 3.3, -10.5), facing: 180.0), // the transmitter room
        (robot: Turret, at: (5.0, 6.6, 7.0), facing: 180.0),
        (robot: Turret, at: (-3.0, -0.3, 7.0), facing: 180.0),
        (robot: Crawler, at: (-6.0, 3.3, 8.0), facing: 180.0),
    ],
    markers: {
        "entry": (0.0, 0.0, 12.5),
        "objective": (2.0, 3.3, -11.0),
        "loot_workshop": (-6.0, 0.0, 8.5),
        "loot_store": (-4.0, 0.0, -12.0),
        "loot_transmitter": (-6.5, 3.3, -11.5),
    },
    devices: [
        // The power room: the main breaker, the board, the feed selector.
        (id: "breaker", label: "Main breaker", kind: Pull, at: (7.88, 1.2, -10.0), face: (-1.0, 0.0, 0.0)),
        (id: "board", label: "Power board", kind: Board(size: (1.6, 2.0), rows: [
            ("MAIN BREAKER", On("breaker")),
            ("COOLANT", On("coolant")),
            ("DISH DRIVE", Port("selector", 0)),
            ("QUARTERS", Port("selector", 1)),
            ("TX BUS", Port("selector", 2)),
            ("TRANSMITTER", On("transmitter")),
        ]), at: (1.15, 1.6, -10.0), face: (1.0, 0.0, 0.0), power: On("breaker")),
        (id: "selector", label: "Feed selector", kind: Junction(ways: 3), at: (4.5, 1.3, -13.88), face: (0.0, 0.0, 1.0), power: On("breaker")),
        // The workshop: the coolant valve.
        (id: "coolant", label: "Coolant valve", kind: Pull, at: (-7.88, 1.2, 0.5), face: (1.0, 0.0, 0.0)),
        // The transmitter room: the transmitter's lever on its cabinet, and
        // a repeater of what it needs.
        (id: "transmitter", label: "Transmitter", kind: Lever, at: (2.0, 4.5, -12.38), face: (0.0, 0.0, 1.0),
         power: All([Port("selector", 2), On("coolant")])),
        (id: "tx_board", label: "Transmitter status", kind: Board(size: (1.2, 1.0), rows: [
            ("TX BUS", Port("selector", 2)),
            ("COOLANT", On("coolant")),
            ("ON AIR", On("transmitter")),
        ]), at: (-7.88, 4.8, -9.0), face: (1.0, 0.0, 0.0), power: On("breaker")),
        // What each way of the selector feeds, and the beacon.
        (id: "dish_lamp", label: "Dish drive", kind: Lamp, at: (-5.8, 6.95, 3.3), face: (0.0, 0.0, 1.0), power: Port("selector", 0)),
        (id: "quarters_lights", kind: Lights(at: [(-5.8, 2.7, 1.0), (-5.8, 2.7, -4.0)]), power: Port("selector", 1)),
        (id: "tx_lights", kind: Lights(at: [(-4.0, 6.0, -10.0), (4.0, 6.0, -10.0), (0.0, 6.0, -12.5)]), power: Port("selector", 2)),
        (id: "beacon", label: "Beacon", kind: Lamp, at: (5.0, 23.9, -9.68), face: (0.0, 0.0, 1.0), power: On("transmitter")),
        // Conduits: the breaker to the selector; the TX bus up through the
        // upper deck to the transmitter; the coolant line from the
        // workshop, along the port wall and across the bow.
        (id: "c_main", kind: Conduit(path: [(7.95, 1.6, -10.0), (7.95, 2.97, -10.0), (7.95, 2.97, -13.95), (4.5, 2.97, -13.95), (4.5, 1.6, -13.95)]), power: On("breaker")),
        (id: "c_tx", kind: Conduit(path: [(5.0, 1.3, -13.95), (5.0, 3.33, -13.95), (4.55, 3.33, -13.95), (4.55, 3.33, -12.6), (4.55, 4.2, -12.6)]), power: Port("selector", 2)),
        (id: "c_coolant", kind: Conduit(path: [(-7.95, 1.6, 0.5), (-7.95, 2.97, 0.5), (-7.95, 2.97, -6.0), (-7.95, 3.33, -6.0), (-7.95, 3.33, -13.95), (-0.55, 3.33, -13.95), (-0.55, 4.2, -13.95)]), power: On("coolant")),
    ],
)
