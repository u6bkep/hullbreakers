// The reference sky: what models are judged under (`asset_view`), the
// model gallery's sky, and what a client shows until the host's ambience
// arrives. Close to the game's first sky (one sun, a teal band, a dim fill)
// without its violet, which sat too near the weak spots' magenta. Change it
// only on purpose: every model was judged under it.
// See src/sim/ambience/mod.rs for what each field means.
Ambience(
    sun: (
        direction: (0.4, 0.5, -0.3),
        color: "#fff6e8",
        illuminance: 12000.0,
        size: 1.5,
        corona: 1.5,
    ),
    light: (ambient: "#99b3ff", ambient_brightness: 60.0, fill: 3500.0),
    stars: (
        seed: 7,
        count: 16000,
        banded: 0.25,
        brightness: 7.0,
        colors: ["#cfdcff", "#ffffff", "#ffffff", "#ffe6c4"],
        glints: 30,
    ),
    band: (
        pole: (0.56, -0.49, -0.07),
        width: 26.0,
        bulge: (-0.4, -0.5, 0.3),
        color: "#5fa8b8",
        bulge_color: "#9cc4cc",
        brightness: 0.09,
        dust: 0.5,
        seed: 11,
        tones: 4,
    ),
    nebulae: [],
    bodies: [],
)
