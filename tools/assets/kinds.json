    "large_robot": {"doc": "Large robot (2-4 m)",              "tris": [8000, 20000], "bevel": [0.01, 0.03],   "default_bevel": 0.02},
    "prop":        {"doc": "Prop, console, crate",             "tris": [500, 3000],   "bevel": [0.005, 0.02],  "default_bevel": 0.01},
    "flora":       {"doc": "Flora cluster (organic, no bevel)", "tris": [1000, 5000], "bevel": [0.0, 0.0],     "default_bevel": 0.0},
    "ship_module": {"doc": "Ship module",                      "tris": [5000, 30000], "bevel": [0.03, 0.15],   "default_bevel": 0.06}
